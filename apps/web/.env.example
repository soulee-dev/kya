# Explicit local demo: simulated sandbox, no real transfers. Identity verification is always a stub.
WEB_DEMO_MODE=true
PUBLIC_HOST=localhost:3000      # 터널 호스트. did:web 과 러너의 KYA_URL 에 쓴다 (예: kya.trycloudflare.com)
VERIFIER_URL=http://localhost:4000
MERCHANT_URL=http://localhost:5050
MERCHANT_PAYTO=
SHOPPING_LIST=A,B,C,C
DAYTONA_API_KEY=
DAYTONA_TARGET=eu
ANTHROPIC_API_KEY=
TREASURY_PRIVATE_KEY=
BASE_SEPOLIA_RPC=https://sepolia.base.org
FUNDING_AMOUNT=20000000
RUNNER_DIR=                     # 팀원이 준 러너 디렉터리 (통째로 /home/daytona/runner 에 업로드)
# 러너 실행 명령. 기본값은 core와 같다.
RUNNER_COMMAND=npm install --omit=dev && node index.js
