{
  "name": "kya",
  "private": true,
  "type": "module",
  "scripts": {
    "web": "pnpm --filter @kya/web dev",
    "verifier": "pnpm --filter @kya/verifier dev",
    "test": "pnpm --filter @kya/core test",
    "typecheck": "pnpm -r typecheck",
    "e2e": "bash scripts/e2e.sh",
    "scenario": "pnpm --filter @kya/verifier scenario",
    "fake-agent": "bash apps/web/scripts/fake-agent.sh",
    "slides": "pnpm --filter @kya/slides dev",
    "slides:build": "pnpm --filter @kya/slides build"
  },
  "devDependencies": {
    "@types/node": "^26.6.2",
    "typescript": "^5.9.3"
  },
  "packageManager": "pnpm@10.28.2"
}
