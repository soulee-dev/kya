# ---- apps/verifier (port 4000) ----
UPSTREAM_FACILITATOR=https://x402.org/facilitator
KYA_SETTLE_MODE=live            # live | mock (mock: 검사만 하고 상위 호출 없이 가짜 tx)
# DID_DOC_OVERRIDE=./fixtures/did.json   # 로컬 시나리오에서만

# ---- apps/platform (port 4001) ----
PUBLIC_HOST=localhost:4001      # 터널 호스트. did:web 에 쓴다 (예: kya.trycloudflare.com)
KYA_URL=http://localhost:4001   # 러너에 주입되는 플랫폼 URL
MERCHANT_URL=http://localhost:3002
ANTHROPIC_API_KEY=
SHOPPING_LIST=A,B,C,C
TREASURY_PRIVATE_KEY=           # 없으면 충전 생략
BASE_SEPOLIA_RPC=https://sepolia.base.org
FUNDING_AMOUNT=20000000
DAYTONA_API_KEY=                # 없으면 로컬 sandbox id 생성
DAYTONA_TARGET=us
RUNNER_DIR=                     # 팀원이 준 러너 디렉터리 (통째로 업로드)
RUNNER_CMD=npm install --omit=dev && node index.js
